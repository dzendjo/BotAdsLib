# Telegram bot token
BOT_TOKEN=<BOT_TOKEN>

# Ad delivery API base URL
ADS_API_BASE_URL=https://app.example.com

# Bot hash from ad platform
ADS_BOT_HASH=<BOT_DELIVERY_HASH>

# Service channel ID for media cache (example)
ADS_CACHE_CHANNEL_ID=-1001234567890

# Optional path for persistent media file_id cache
ADS_MEDIA_CACHE_PATH=.botads-media-cache.json

# Optional admin chat ID for technical alerts
# BOT_ADMIN_CHAT_ID=123456789
